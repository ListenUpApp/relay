{
  "name": "relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  // Secrets (never here): FCM_SERVICE_ACCOUNT via `wrangler secret put`.
  // SENDER_TOKEN (optional, phase 1 — see PROTOCOL.md "Sender credential"): the shared
  // secret every self-hosted server presents on /v1/send. Unset means every call is
  // treated as unauthenticated but still served (migration window); once every known
  // server has upgraded, phase 2 flips absent-credential calls to 401 (a separate deploy).
  "routes": [{ "pattern": "push.listenup.audio", "custom_domain": true }]
}
